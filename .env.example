# =====================================================================
# QuizVerse Live — Environment Configuration Template
# All secrets and API keys must remain server-side.
# Never commit actual credentials to Git.
# =====================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) & WebSocket Allowed Origins
# Comma-separated list of origins permitted to connect
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./quizverse.db

# Production: PostgreSQL (required when ENVIRONMENT=production)
# Format: postgresql+psycopg://username:password@host:port/database
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/quizverse

# PostgreSQL Connection Pooling (production defaults)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Presence & Session Configuration
PRESENCE_GRACE_PERIOD=10.0

# AI Quiz Generation & Intelligence Engine (Optional)
AI_GENERATION_ENABLED=false
AI_FREE_TIER_ONLY=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
